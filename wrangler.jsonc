{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "heatsafe",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "build": {
    "command": "npm run build:worker"
  },
  "observability": {
    "enabled": true
  }
}
