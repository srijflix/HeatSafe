{
  "name": "heatsafe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev --hostname 0.0.0.0",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "start": "next start --hostname 0.0.0.0"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "leaflet": "^1.9.4",
    "lucide-react": "latest",
    "next": "^16.3.6",
    "react": "latest",
    "react-dom": "latest",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.142.0"
  }
}
